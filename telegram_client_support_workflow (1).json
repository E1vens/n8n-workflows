      "parameters": {
        "functionCode": "\nconst message = $json[\"message\"][\"text\"];\nlet reply = \"\u042f \u0432\u0430\u0441 \u043d\u0435 \u043f\u043e\u043d\u044f\u043b. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u0435 \u0432\u043e\u043f\u0440\u043e\u0441.\";\n\nif (message.toLowerCase().includes(\"\u043f\u0440\u0438\u0432\u0435\u0442\")) {\n  reply = \"\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435! \u0427\u0435\u043c \u043c\u043e\u0433\u0443 \u043f\u043e\u043c\u043e\u0447\u044c?\";\n} else if (message.toLowerCase().includes(\"\u0446\u0435\u043d\u0430\")) {\n  reply = \"\u0410\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u0446\u0435\u043d\u044b \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0443\u0437\u043d\u0430\u0442\u044c, \u0443\u043a\u0430\u0437\u0430\u0432 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u044e\u0449\u0438\u0439 \u0442\u043e\u0432\u0430\u0440.\";\n} else if (message.toLowerCase().includes(\"\u043a\u0430\u0442\u0430\u043b\u043e\u0433\")) {\n  reply = \"\u041a\u0430\u0442\u0430\u043b\u043e\u0433 \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435: https://example.com/catalog\";\n}\n\nreturn [{ json: { chat_id: $json[\"message\"][\"chat\"][\"id\"], text: reply } }];\n"
      },
