{
  "name": "Telegram Client Support",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "\nconst message = $json.message?.text;\nlet reply = \"Я вас не понял. Пожалуйста, уточните вопрос.\";\n\nif (typeof message === 'string') {\n  const msg = message.toLowerCase();\n  if (msg.includes(\"привет\")) {\n    reply = \"Здравствуйте! Чем могу помочь?\";\n  } else if (msg.includes(\"цена\")) {\n    reply = \"Актуальные цены вы можете узнать, указав интересующий товар.\";\n  } else if (msg.includes(\"каталог\")) {\n    reply = \"Каталог доступен по ссылке: https://example.com/catalog\";\n  }\n}\n\nreturn [{ json: { chat_id: $json.message.chat.id, text: reply } }];\n"
      },
      "name": "Process Message",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$json[\"chat_id\"]}}",
        "text": "={{$json[\"text\"]}}"
      },
      "name": "Send Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Process Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Message": {
      "main": [
        [
          {
            "node": "Send Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
